page 1 (
    name: Operations & AI Overview
    alias: HOME
    title: Operations & AI Overview
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region app-name (
        name: Operations & AI Overview
        title: &APP_TITLE.
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Oracle AI Database 26ai, Oracle APEX 26.1, and Google Cloud Vertex AI operations console for Cymbal Coffee.</p>
                ```
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region platform-kpis (
        name: Live Oracle 26ai & Vertex AI Metrics
        title: Live Oracle 26ai & Vertex AI Metrics
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Catalog Products' as metric,
                       to_char(count(*)) as current_value,
                       'Menu items in PRODUCT table' as details
                  from product
                union all
                select 'Embedded 3072-Dim Vectors' as metric,
                       to_char(sum(case when embedding is not null then 1 else 0 end)) as current_value,
                       'gemini-embedding-2 VECTOR(3072, FLOAT32) rows ready for HNSW search' as details
                  from product
                union all
                select 'Seeded DFW Cafe Stores' as metric,
                       to_char(count(*)) as current_value,
                       'Locations in STORE with keyless Google Maps URLs' as details
                  from store
                union all
                select 'Low or Out-of-Stock Inventory Rows' as metric,
                       to_char(sum(case when stock_status in ('LOW_STOCK', 'OUT_OF_STOCK') then 1 else 0 end)) as current_value,
                       'Store-level inventory alerts in STORE_PRODUCT_INVENTORY' as details
                  from store_product_inventory
                union all
                select 'Oracle 26ai Schema Annotations' as metric,
                       to_char(count(*)) as current_value,
                       'AI grounding metadata declared in USER_ANNOTATIONS_USAGE' as details
                  from user_annotations_usage
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            savedReportMappingIdentifier: 3634811204664501
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region vertex-architecture-bridge (
        name: Vertex AI & Litestar REST Integration
        title: Vertex AI & Litestar REST Integration
        type: staticContent
        source {
            htmlCode:
                ```html
                <p><strong>COFFEE_VERTEX_AI</strong> connects Oracle APEX 26.1 directly to Google Cloud Vertex AI (<code>/endpoints/openapi</code> with <code>google/gemini-3.8-flash</code>) or through the Litestar OpenAI-compatible gateway (<code>/api/apex/ai/v1</code>). Operational REST endpoints remain available under <code>/api/apex/*</code>.</p>
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

)
