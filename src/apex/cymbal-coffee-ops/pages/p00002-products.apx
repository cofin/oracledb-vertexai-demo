page 2 (
    name: Coffee & Bakery Catalog
    alias: PRODUCTS
    title: Coffee & Bakery Catalog
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region product-catalog (
        name: Coffee & Bakery Catalog
        title: Coffee & Bakery Catalog
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id,
                       sku,
                       name,
                       category,
                       coalesce(json_value(metadata, '$.roast_level'), 'n/a') as roast_level,
                       price as price_usd,
                       case when in_stock then 'Yes' else 'No' end as global_in_stock,
                       case when embedding is not null then 'Ready (3072d)' else 'Missing' end as vector_status,
                       description
                  from product
                 order by category, name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            savedReportMappingIdentifier: 3634989706664501
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region products-api (
        name: Litestar REST Endpoint (/api/apex/products)
        title: Litestar REST Endpoint (/api/apex/products)
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Mirrors <code>GET /api/apex/products</code> over the shared <code>PRODUCT</code> table in schema <code>APP</code>, reporting dollar pricing and <code>VECTOR(3072, FLOAT32)</code> embedding readiness for <code>gemini-embedding-2</code>.</p>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

)
