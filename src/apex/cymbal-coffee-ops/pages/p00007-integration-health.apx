page 7 (
    name: 26ai & Vertex AI Health
    alias: INTEGRATION-HEALTH
    title: 26ai & Vertex AI Health
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region apex-vertex-readiness (
        name: APEX 26.1 Release & Vertex AI Credential Readiness
        title: APEX 26.1 Release & Vertex AI Credential Readiness
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select r.version_no as apex_version,
                       r.api_compatibility,
                       (
                           select count(*)
                             from apex_workspace_credentials c
                            where c.static_id = 'VERTEX_AI_CRED'
                       ) as vertex_credential_count,
                       'COFFEE_VERTEX_AI' as generative_ai_service_id,
                       '/api/apex/ai/v1' as litestar_gateway_path
                  from apex_release r
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            savedReportMappingIdentifier: 3635716241664502
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region integration-health (
        name: Integration Health Overview
        title: Integration Health Overview
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Live readiness diagnostics across Oracle AI Database 26ai <code>USER_ANNOTATIONS_USAGE</code>, <code>VECTOR(3072, FLOAT32)</code> embedding coverage (<code>gemini-embedding-2</code>), <code>APEX_RELEASE</code>, and the <code>VERTEX_AI_CRED</code> / <code>COFFEE_VERTEX_AI</code> Generative AI Service configuration.</p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region schema-annotations (
        name: Oracle 26ai AI Schema Annotations (USER_ANNOTATIONS_USAGE)
        title: Oracle 26ai AI Schema Annotations (USER_ANNOTATIONS_USAGE)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select object_name,
                       object_type,
                       coalesce(column_name, '(table-level)') as column_name,
                       annotation_name,
                       annotation_value
                  from user_annotations_usage
                 order by object_name, column_name nulls first, annotation_name
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            savedReportMappingIdentifier: 3635941108664502
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region vector-status-api (
        name: Vertex AI Embedding Coverage (/api/apex/vector/status)
        title: Vertex AI Embedding Coverage (/api/apex/vector/status)
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'gemini-embedding-2' as embedding_model,
                       3072 as embedding_dimensions,
                       count(*) as product_count,
                       sum(case when embedding is not null then 1 else 0 end) as embedded_product_count,
                       sum(case when embedding is null then 1 else 0 end) as missing_embedding_count
                  from product
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            savedReportMappingIdentifier: 3635868625664502
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

)
