page 4 (
    name: Store Inventory
    alias: STORE-INVENTORY
    title: Store Inventory
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region inventory-api (
        name: Litestar Inventory Summary Endpoint (/api/apex/inventory/summary)
        title: Litestar Inventory Summary Endpoint (/api/apex/inventory/summary)
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Aggregates <code>STORE_PRODUCT_INVENTORY</code> stock states (<code>IN_STOCK</code>, <code>LOW_STOCK</code>, <code>OUT_OF_STOCK</code>) and pickup quantities across DFW cafe locations, matching <code>GET /api/apex/inventory/summary</code>.</p>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region inventory-summary (
        name: Store Inventory Summary
        title: Store Inventory Summary
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select s.name as store_name,
                       s.city,
                       count(spi.product_id) as tracked_products,
                       sum(case when spi.stock_status = 'IN_STOCK' then 1 else 0 end) as in_stock_count,
                       sum(case when spi.stock_status = 'LOW_STOCK' then 1 else 0 end) as low_stock_count,
                       sum(case when spi.stock_status = 'OUT_OF_STOCK' then 1 else 0 end) as out_of_stock_count,
                       coalesce(sum(spi.quantity_available), 0) as total_pickup_units
                  from store s
                  left join store_product_inventory spi on spi.store_id = s.id
                 group by s.id, s.name, s.city
                 order by s.city, s.name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            savedReportMappingIdentifier: 3635396455664502
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

)
