page 3 (
    name: DFW Store Directory
    alias: STORES
    title: DFW Store Directory
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region stores (
        name: DFW Store Directory
        title: DFW Store Directory
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id,
                       name,
                       address,
                       city,
                       state,
                       zip,
                       phone,
                       timezone,
                       coalesce(json_value(hours, '$.monday'), 'See store') as monday_hours,
                       'https://www.google.com/maps/search/?api=1&query='
                           || utl_url.escape(name || ' ' || address || ', ' || city || ', ' || state || ' ' || zip, true)
                           as google_maps_url
                  from store
                 order by city, name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        advanced {
            savedReportMappingIdentifier: 3635162368664502
        }
        page {
            borderWidth: 0.5
            borderColor: #666666
        }
    )

    region stores-api (
        name: Coordinate Privacy & Maps Contract (/api/apex/stores)
        title: Coordinate Privacy & Maps Contract (/api/apex/stores)
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Builds keyless Google Maps search links purely from seeded <code>STORE</code> street addresses (matching <code>GET /api/apex/stores</code>). User browser coordinates are never requested, logged, cached, or stored in Oracle.</p>
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

)
